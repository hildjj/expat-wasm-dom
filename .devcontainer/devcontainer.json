{
  "name": "Node.js",
  "image": "mcr.microsoft.com/devcontainers/javascript-node",
  "features": {
    "ghcr.io/devcontainers/features/node": {
        "version": "26",
        "pnpmVersion": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig"
      ]
    }
  },
  "postCreateCommand": "sudo npm install -g npm-check-updates"
}
