{
  "name": "expat-wasm-dom",
  "version": "2.0.3",
  "description": "Document Object Model for expat-wasm",
  "main": "lib/index.js",
  "type": "module",
  "files": [
    "lib/"
  ],
  "scripts": {
    "pretest": "npm run ts -- --inlineSourceMap",
    "test": "c8 ava test",
    "posttest": "npm run ts",
    "grammar": "peggy -c .peggy.config.js",
    "lint": "eslint",
    "docs": "typedoc",
    "prets": "npm run grammar",
    "ts": "tsc",
    "conformance": "cd test && tar zxf xmlts20130923.tar.gz",
    "version": "monopub version && pnpm i -r && git add pnpm-lock.yaml",
    "build": "npm run conformance && npm run grammar && npm run ts && npm test && npm run docs && npm run lint"
  },
  "workspaces": [
    ".",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hildjj/expat-wasm-dom.git"
  },
  "keywords": [
    "xml",
    "parse",
    "dom",
    "xpath",
    "wasm"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "dependencies": {
    "@cto.af/linewrap": "5.0.0",
    "expat-wasm": "5.0.0"
  },
  "devDependencies": {
    "@cto.af/eslint-config": "7.0.4",
    "@cto.af/monopub": "2.0.2",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "ava": "^8.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "peggy": "^5.1.1",
    "superc8": "^12.7.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  }
}
